<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="legal_memo_final_clean"
              pageWidth="595" pageHeight="842"
              columnWidth="555"
              leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <!-- PARAMETERS -->
    <parameter name="logo" class="java.lang.String"/>
    <parameter name="branchAddress" class="java.lang.String"/>
    <parameter name="borrowerName" class="java.lang.String"/>
    <parameter name="applicationId" class="java.lang.String"/>
    <parameter name="loanType" class="java.lang.String"/>
    <parameter name="loanAmount" class="java.lang.Double"/>
    <parameter name="propertyAddress" class="java.lang.String"/>
    <parameter name="legalOpinion" class="java.lang.String"/>
    <parameter name="recommendation" class="java.lang.String"/>
    <parameter name="advocateName" class="java.lang.String"/>
    <parameter name="preparedDate" class="java.lang.String"/>
    <parameter name="qrText" class="java.lang.String"/>
    <parameter name="digitalSignature" class="java.lang.String"/>

    <!-- TITLE -->
    <title>
        <band height="100">

            <image>
                <reportElement x="0" y="10" width="80" height="40"/>
                <imageExpression><![CDATA[$P{logo}]]></imageExpression>
            </image>

            <staticText>
                <reportElement x="100" y="10" width="400" height="20"/>
                <textElement><font size="14" isBold="true"/></textElement>
                <text><![CDATA[IDB Kenya Bank Ltd]]></text>
            </staticText>

            <textField>
                <reportElement x="100" y="30" width="400" height="20"/>
                <textFieldExpression><![CDATA[$P{branchAddress}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="60" width="555" height="25"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[LEGAL MEMORANDUM REPORT]]></text>
            </staticText>

            <line>
                <reportElement x="0" y="90" width="555" height="1"/>
            </line>

        </band>
    </title>

    <!-- DETAIL -->
    <detail>
        <band height="600">

            <!-- Applicant -->
            <staticText>
                <reportElement x="0" y="10" width="555" height="20" mode="Opaque" backcolor="#EAEAEA"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[1. Applicant Details]]></text>
            </staticText>

            <textField>
                <reportElement x="10" y="35" width="260" height="20"/>
                <textFieldExpression><![CDATA["Borrower: " + $P{borrowerName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="280" y="35" width="260" height="20"/>
                <textFieldExpression><![CDATA["App ID: " + $P{applicationId}]]></textFieldExpression>
            </textField>

            <!-- Loan -->
            <staticText>
                <reportElement x="0" y="70" width="555" height="20" mode="Opaque" backcolor="#EAEAEA"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[2. Loan Details]]></text>
            </staticText>

            <textField>
                <reportElement x="10" y="95" width="260" height="20"/>
                <textFieldExpression><![CDATA["Type: " + $P{loanType}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="280" y="95" width="260" height="20"/>
                <textFieldExpression><![CDATA["Amount: ₹ " + $P{loanAmount}]]></textFieldExpression>
            </textField>

            <!-- Property -->
            <staticText>
                <reportElement x="0" y="130" width="555" height="20" mode="Opaque" backcolor="#EAEAEA"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[3. Property Details]]></text>
            </staticText>

            <textField isStretchWithOverflow="true">
                <reportElement x="10" y="155" width="535" height="40"/>
                <textFieldExpression><![CDATA[$P{propertyAddress}]]></textFieldExpression>
            </textField>

            <!-- Legal Opinion -->
            <staticText>
                <reportElement x="0" y="210" width="555" height="20" mode="Opaque" backcolor="#EAEAEA"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[4. Legal Opinion]]></text>
            </staticText>

            <textField isStretchWithOverflow="true">
                <reportElement x="10" y="235" width="535" height="60"/>
                <textFieldExpression><![CDATA[$P{legalOpinion}]]></textFieldExpression>
            </textField>

            <!-- Recommendation -->
            <staticText>
                <reportElement x="0" y="310" width="555" height="20" mode="Opaque" backcolor="#EAEAEA"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[5. Recommendation]]></text>
            </staticText>

            <textField isStretchWithOverflow="true">
                <reportElement x="10" y="335" width="535" height="50"/>
                <textFieldExpression><![CDATA[$P{recommendation}]]></textFieldExpression>
            </textField>

            <!-- QR -->
            <image>
                <reportElement x="420" y="400" width="100" height="100"/>
                <imageExpression><![CDATA[
                    "https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=" + $P{qrText}
                ]]></imageExpression>
            </image>

            <!-- Signature -->
            <staticText>
                <reportElement x="10" y="400" width="200" height="20"/>
                <text><![CDATA[Authorized Legal Counsel]]></text>
            </staticText>

            <image>
                <reportElement x="10" y="430" width="180" height="50"/>
                <imageExpression><![CDATA[$P{digitalSignature}]]></imageExpression>
            </image>

            <textField>
                <reportElement x="10" y="490" width="300" height="20"/>
                <textFieldExpression><![CDATA[$P{advocateName}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- FOOTER -->
    <pageFooter>
        <band height="40">

            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
            </line>

            <textField>
                <reportElement x="0" y="10" width="300" height="20"/>
                <textFieldExpression><![CDATA["Date: " + $P{preparedDate}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="250" y="10" width="300" height="20"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Verified Legal Document]]></text>
            </staticText>

        </band>
    </pageFooter>

</jasperReport>